# ----------------------------------------------------------------
# Database
# ----------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/aldera_tech?schema=public"

# ----------------------------------------------------------------
# NextAuth
# Generate secret: `openssl rand -base64 32`
# ----------------------------------------------------------------
AUTH_SECRET="change-me-please-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: enable trusting the host (needed when running behind a reverse proxy)
AUTH_TRUST_HOST="true"

# ----------------------------------------------------------------
# Cron
# Used by the invoice-reminder cron endpoint:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/invoice-reminder
# ----------------------------------------------------------------
CRON_SECRET="change-me-another-random-string"

# ----------------------------------------------------------------
# Seeding (dev only) — controls default admin credentials in prisma/seed.ts
# ----------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@aldera.tech"
SEED_ADMIN_PASSWORD="password"

# ----------------------------------------------------------------
# WhatsApp API (Fonnte: https://api.fonnte.com/send)
# All notifications, invoices, reminders, password resets, and
# proposals are dispatched via WhatsApp Fonnte.
# If WHATSAPP_API_KEY is empty, messages are logged to console.
# ----------------------------------------------------------------
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_KEY="your-fonnte-api-key"

# ----------------------------------------------------------------
# Sharp / Image Processing
# Prevents sharp from trying to compile against system-installed libvips
# ----------------------------------------------------------------
SHARP_IGNORE_GLOBAL_LIBVIPS=1

# ----------------------------------------------------------------
# Payment Gateway (Midtrans)
# https://dashboard.midtrans.com/
# Set MIDTRANS_IS_PRODUCTION="true" untuk environment produksi.
# ----------------------------------------------------------------
MIDTRANS_SERVER_KEY="SB-Mid-server-your-server-key"
MIDTRANS_CLIENT_KEY="SB-Mid-client-your-client-key"
MIDTRANS_IS_PRODUCTION="false"

# ----------------------------------------------------------------
# Cloudflare Turnstile (Anti-Spam & Bot Protection)
# https://dash.cloudflare.com/?to=/:account/turnstile
# In dev/test, leaving keys empty automatically enables mock bypass.
# Cloudflare Test Keys:
# Always Passes: SiteKey: 1x00000000000000000000AA, Secret: 1x0000000000000000000000000000000AA
# ----------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ----------------------------------------------------------------
# Aldera AI Relay & 9router Synchronization
# ----------------------------------------------------------------
ROUTER_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aldera_router"
NINE_ROUTER_BASE_URL="http://localhost:20128"
NINE_ROUTER_API_KEY=""
