# ----------------------------------------------------------------
# Database
# ----------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/solvo_tech?schema=public"

# ----------------------------------------------------------------
# NextAuth
# Generate secret: `openssl rand -base64 32`
# ----------------------------------------------------------------
AUTH_SECRET="change-me-please-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: enable trusting the host (needed when running behind a reverse proxy)
AUTH_TRUST_HOST="true"

# ----------------------------------------------------------------
# SMTP (for invoice emails and reminders)
# ----------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Solvo Tech <no-reply@solvo.tech>"

# ----------------------------------------------------------------
# Cron
# Used by the invoice-reminder cron endpoint:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/invoice-reminder
# ----------------------------------------------------------------
CRON_SECRET="change-me-another-random-string"

# ----------------------------------------------------------------
# Seeding (dev only) — controls default admin credentials in prisma/seed.ts
# ----------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@solvo.tech"
SEED_ADMIN_PASSWORD="password"

# ----------------------------------------------------------------
# WhatsApp Notification API (Fonnte/Wablas/custom)
# If not set, WhatsApp messages are logged to console.
# ----------------------------------------------------------------
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_KEY="your-api-key"

# ----------------------------------------------------------------
# Sharp / Image Processing
# Prevents sharp from trying to compile against system-installed libvips
# ----------------------------------------------------------------
SHARP_IGNORE_GLOBAL_LIBVIPS=1
